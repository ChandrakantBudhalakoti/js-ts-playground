{
  "name": "js-ts-playground",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/prepare-assets.mjs --optional",
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "1.58.0",
    "monaco-editor": "0.57.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "prettier": "3.9.10",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
